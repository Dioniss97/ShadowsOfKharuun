; Shadows of Kharuun - procedural RPG demo
config_version=5

[application]
config/name="Shadows of Kharuun"
config/version="0.4.0-rc1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="Asalto al templo de Kharuun. Demo RPG procedural."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.035, 0.028, 1)

[audio]
general/text_to_speech=true

[physics]
common/physics_ticks_per_second=60
